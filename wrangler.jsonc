{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "site-1"
    }
  ],
  // Database: projects, posts, products, orders, users, sessions...
  // Create it once with `npx wrangler d1 create site-1-db` and paste the id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-1-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // File storage: images (public) and downloadable product files (private).
  // Create it once with `npx wrangler r2 bucket create site-1-files`.
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "site-1-files"
    }
  ],
  "vars": {
    // Anyone who signs in with a verified email in this list becomes an admin.
    // Comma separated.
    "ADMIN_EMAILS": "admin@3darmaments.com"
  },
  "observability": {
    "enabled": true
  }
}

# Copy to .env.local for `next dev`, and to .dev.vars for `npm run preview`.
# NEXT_PUBLIC_* values are baked in at build time, so they must also be set
# wherever `npm run deploy` runs (locally or in Cloudflare Workers Builds).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secrets. In production set them with `npx wrangler secret put NAME`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
